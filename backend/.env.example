# Field Shift - NASA Space Apps 2026 Backend Configuration
# Copy this file to .env and fill in your credentials

# Application
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production
API_V1_PREFIX=/api/v1

# NASA Earthdata (for GPM, SMAP, Landsat, Sentinel-2 downloads)
# Register at: https://urs.earthdata.nasa.gov/
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Copernicus Data Space (for Sentinel-2)
# Register at: https://dataspace.copernicus.eu/
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# NASA API (optional - for higher rate limits)
NASA_API_KEY=

# AWS (optional - for direct S3 access to NASA data)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-west-2

# OpenET (optional - for evapotranspiration data)
OPENET_API_KEY=

# Database (optional - Supabase/PostgreSQL)
DATABASE_URL=

# Redis (optional - for caching)
REDIS_URL=

# Frontend URLs
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_MAPBOX_TOKEN=