# NASA Space Apps 2026 - Field Shift Backend Configuration
# Copy this file to .env and fill in your credentials

# Application
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production
API_V1_PREFIX=/api/v1

# NASA Earthdata Authentication (REQUIRED for SMAP, GPM, Landsat, MODIS, ECOSTRESS, ICESat-2)
# Register at: https://urs.earthdata.nasa.gov/
EARTHDATA_USERNAME=your_earthdata_username
EARTHDATA_PASSWORD=your_earthdata_password

# Copernicus Data Space (for Sentinel-2 STAC API with authentication)
# Register at: https://dataspace.copernicus.eu/
COPERNICUS_CLIENT_ID=your_copernicus_client_id
COPERNICUS_CLIENT_SECRET=your_copernicus_client_secret

# NASA API Key (optional - for higher rate limits)
# Get at: https://api.nasa.gov/
NASA_API_KEY=your_nasa_api_key

# AWS Credentials (optional - for direct S3 access to NASA data)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-west-2

# OpenET API Key (optional - for field-scale ET data)
# Get at: https://openet.dri.edu/
OPENET_API_KEY=your_openet_api_key

# Database (optional - for persistence)
# DATABASE_URL=postgresql://user:pass@localhost:5432/fieldshift

# Redis (optional - for caching)
# REDIS_URL=redis://localhost:6379/0

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_MAPBOX_TOKEN=your_mapbox_token