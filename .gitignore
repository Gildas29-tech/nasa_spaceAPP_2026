*.sqlite
*.db

# Cache
.cache/
.pytest_cache/
.coverage/
htmlcov/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs
dist/
build/
*.tsbuildinfo

# Docker
.docker/

