# NASA Earthdata Credentials (REQUIRED)
# Get free account at: https://urs.earthdata.nasa.gov/users/new
EARTHDATA_USERNAME=your_earthdata_username
EARTHDATA_PASSWORD=your_earthdata_password

# NASA API Key (OPTIONAL - for higher rate limits)
# Get at: https://api.nasa.gov/
NASA_API_KEY=your_nasa_api_key

# AWS Credentials (OPTIONAL - for S3 direct access to Earthdata Cloud)
# Only works from us-west-2 region
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-west-2

# OpenET API Key (OPTIONAL - for field-scale ET data)
# Get at: https://openetdata.org/
OPENET_API_KEY=your_openet_api_key

# Database (OPTIONAL - for production)
DATABASE_URL=postgresql://user:pass@localhost:5432/fieldshift

# Redis (OPTIONAL - for caching)
REDIS_URL=redis://localhost:6379/0

# Application
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production
API_V1_PREFIX=/api/v1

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_MAPBOX_TOKEN=your_mapbox_token (or use MapLibre free)